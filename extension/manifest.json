{
  "name": "Vibe Coding Extension",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "Embeds local SSH tunnel into a Chrome side panel",
  "permissions": ["sidePanel", "tabs", "clipboardWrite", "scripting"],
  "host_permissions": ["https://localhost:7682/"],
  "action": {
    "default_title": "SSH Terminal"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
